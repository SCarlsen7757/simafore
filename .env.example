# Configuration is read on container startup. Recreate the board after changes.
IMAGE_TAG=latest
BOARD_PORT=8081
TZ=Europe/Copenhagen
USER_AGENT=SiemensBoard/1.0 (+mailto:automation@example.com)
POLL_INTERVAL_MIN=30
REQUEST_INTERVAL_SECONDS=60
RATE_LIMIT_COOLDOWN_MIN=60
POLL_ON_START=true
STALE_AFTER_MIN=120
PRODUCT_FAMILIES=SIMATIC,S7-1200,S7-1200 G2,S7-1500,ET 200,TIA Portal,STEP 7,WinCC,WinCC Unified,S7-PLCSIM,SINAMICS,SCALANCE,Industrial Edge
PRODUCT_KEYWORDS=PROFINET,PROFIBUS,OPC UA
# recent-severity | newest-first | highest-severity
PRIORITY_MODE=recent-severity
# Prioritize this window by severity, then fill from RECENT_DAYS newest first.
SEVERITY_DAYS=7
RECENT_DAYS=90
HERO_COUNT=6
RAIL_COUNT=6
ROTATE_SECONDS=25
# Only needed with --profile tunnel. Never commit your real token.
CLOUDFLARE_TUNNEL_TOKEN=
